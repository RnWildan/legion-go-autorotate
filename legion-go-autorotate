#!/bin/bash
# =============================================================================
# Legion Go auto-rotation daemon for driftWM
#
# Two-stage approach:
#   1. PRIMARY: pipe iio-sensor-proxy's `monitor-sensor --accel` (hardened
#      hysteresis built into iio-sensor-proxy — handles the "tilted flat"
#      ambiguity far better than raw sysfs math can).
#   2. FALLBACK: read accelerometer from sysfs with median filtering (5 samples)
#      and angle-based orientation detection with dead-zone hysteresis.
#
# Toggle via FLAG_FILE.
# =============================================================================

export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"

DISPLAY_NAME="eDP-1"
ACCEL_BASE="/sys/bus/iio/devices/iio:device1"
POLL_INTERVAL=0.3          # fallback poll interval
MEDIAN_WINDOW=5            # fallback median filter window size
CONFIRM_COUNT=3            # consecutive identical readings to switch
FLAG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/driftwm/autorotate-disabled"

log() { echo "[autorotate] $(date '+%H:%M:%S') $*"; }

# ── Wait for Wayland socket ────────────────────────────────────────────────
log "Starting — waiting for $XDG_RUNTIME_DIR/$WAYLAND_DISPLAY"
for i in $(seq 1 60); do
    [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ] && break
    sleep 1
done

# ── Wait for wlr-randr ─────────────────────────────────────────────────────
log "Waiting for wlr-randr (compositor)..."
for i in $(seq 1 60); do
    if WAYLAND_DISPLAY="$WAYLAND_DISPLAY" wlr-randr >/dev/null 2>&1; then
        log "wlr-randr connected"
        break
    fi
    sleep 2
done
if ! WAYLAND_DISPLAY="$WAYLAND_DISPLAY" wlr-randr >/dev/null 2>&1; then
    log "ERROR: wlr-randr not available. Exiting."
    exit 1
fi

# ── Apply a transform ──────────────────────────────────────────────────────
apply_transform() {
    local transform="$1"
    WAYLAND_DISPLAY="$WAYLAND_DISPLAY" \
        wlr-randr --output "$DISPLAY_NAME" --transform "$transform" 2>&1 || \
        log "Failed to apply transform $transform"
}

# ── Map orientation string → wlr-randr transform ───────────────────────────
orientation_to_transform() {
    case "$1" in
        normal)    echo "normal" ;;
        left-up)   echo "270" ;;
        bottom-up) echo "180" ;;
        right-up)  echo "90" ;;
        *)         echo "" ;;
    esac
}

# ═══════════════════════════════════════════════════════════════════════════
#  PRIMARY: use iio-sensor-proxy's monitor-sensor
# ═══════════════════════════════════════════════════════════════════════════
run_with_monitor_sensor() {
    log "Using iio-sensor-proxy (monitor-sensor --accel)"

    prev_orientation=""
    disabled_prev=""
    last_change_ts=0
    DEBOUNCE_SEC=4
    now=0

    # monitor-sensor --accel outputs:
    #   Initial: === Has accelerometer (orientation: normal, tilt: ...)
    #   Change:  Accelerometer orientation changed: normal
    # We extract the orientation value from either format.
    # Fake PTY via `script` to force line-buffered output when piped
    script -q -f -c 'monitor-sensor --accel' /dev/null 2>&1 | grep --line-buffered -v '^$' | while IFS= read -r line; do
        # Strip carriage return (script output via PTY)
        line="${line%$'\r'}"
        # Check toggle state
        if [ -f "$FLAG_FILE" ]; then
            if [ "$disabled_prev" != "yes" ]; then
                log "Autorotation DISABLED (flag file present)"
                disabled_prev="yes"
            fi
            continue
        fi
        if [ "$disabled_prev" = "yes" ]; then
            log "Autorotation ENABLED"
            disabled_prev="no"
            prev_orientation=""  # force re-check on re-enable
            last_change_ts=0      # reset debounce too
        fi

        # Parse orientation from monitor-sensor output
        orientation=$(echo "$line" | sed -n 's/.*orientation\( changed\)\{0,1\}: *\([a-z-]*\).*/\2/p')
        [ -z "$orientation" ] && continue

        if [ "$orientation" != "$prev_orientation" ]; then
            now=$(date +%s)
            if [ $(( now - last_change_ts )) -lt "$DEBOUNCE_SEC" ]; then
                # Still in debounce window — don't flip yet
                continue
            fi
            transform=$(orientation_to_transform "$orientation")
            if [ -n "$transform" ]; then
                log "Orientation: $orientation → transform $transform"
                apply_transform "$transform"
                prev_orientation="$orientation"
                last_change_ts=$now
            fi
        fi
    done
}

# ═══════════════════════════════════════════════════════════════════════════
#  FALLBACK: direct sysfs with median filter + angle-based detection
# ═══════════════════════════════════════════════════════════════════════════
run_sysfs_fallback() {
    log "Using direct sysfs + median filter (monitor-sensor unavailable)"

    # Read raw accelerometer values
    read_accel() {
        local x y z
        x=$(cat "$ACCEL_BASE/in_accel_x_raw" 2>/dev/null || echo 0)
        y=$(cat "$ACCEL_BASE/in_accel_y_raw" 2>/dev/null || echo 0)
        z=$(cat "$ACCEL_BASE/in_accel_z_raw" 2>/dev/null || echo 0)
        echo "$x $y $z"
    }

    # Median of a small array (bubble-sort the integers)
    median() {
        printf '%s\n' "$@" | sort -n | sed -n "$(( ($# + 1) / 2 ))p"
    }

    # Collect N samples, return median for each axis
    median_read() {
        local xs=() ys=() zs=() sample x y z
        for i in $(seq 1 "$MEDIAN_WINDOW"); do
            read -r x y z < <(read_accel)
            xs+=("$x"); ys+=("$y"); zs+=("$z")
            sleep 0.05
        done
        echo "$(median "${xs[@]}") $(median "${ys[@]}") $(median "${zs[@]}")"
    }

    # Detect orientation from gravity vector.
    #
    # Legion Go coordinate system (iio:device2):
    #   X: left(+) / right(-) — landscape tilt
    #   Y: bottom(+) / top(-)  — portrait gravity
    #   Z: front(-) / back(+)   — flatness
    #
    # Orientation mapping:
    #   normal:   Y is strongly negative (top-up in portrait)
    #   bottom-up: Y is strongly positive
    #   left-up:   X is strongly negative
    #   right-up:  X is strongly positive
    #
    # Flat-clamp: when |Z| dominates, DON'T rotate (stay in current orientation).
    # This prevents the "tilted slightly back" flutter.
    detect_orientation() {
        local x y z abs_x abs_y abs_z max_axis max_val
        read -r x y z < <(median_read)
        abs_x=$(( x < 0 ? -x : x ))
        abs_y=$(( y < 0 ? -y : y ))
        abs_z=$(( z < 0 ? -z : z ))

        # ── Flat detection: if Z is within 30% of the dominant axis, clamp ──
        # Find which axis is strongest
        if [ "$abs_x" -ge "$abs_y" ] && [ "$abs_x" -ge "$abs_z" ]; then
            max_axis="x"; max_val=$abs_x
        elif [ "$abs_y" -ge "$abs_z" ]; then
            max_axis="y"; max_val=$abs_y
        else
            max_axis="z"; max_val=$abs_z
        fi

        # If Z dominates, device is face-up / face-down → don't rotate
        if [ "$max_axis" = "z" ]; then
            echo "flat"
            return
        fi

        # If Z is more than 70% of the max, the device is too flat to reliably
        # determine orientation — stick with current orientation (return "flat")
        if [ "$max_axis" != "z" ] && [ $(( abs_z * 10 )) -gt $(( max_val * 7 )) ]; then
            echo "flat"
            return
        fi

        # ── Angle-based orientation with hysteresis ─────────────────────────
        # Compute the angle of the gravity vector in the X-Y plane.
        # atan2(y, x) in shell: approximate using quadrant logic.
        # Positive X = right-up, Positive Y = bottom-up, etc.
        #
        # We use a two-step approach:
        # 1. Determine the dominant axis (X or Y) and its sign
        # 2. Require the dominant axis to be at least 1.4× the other axis

        local ratio
        if [ "$abs_x" -ge "$abs_y" ]; then
            # X-dominant: left-up (X neg) or right-up (X pos)
            ratio=$(( abs_x * 10 / (abs_y + 1) ))  # +1 to avoid div by zero
            if [ "$ratio" -lt 14 ]; then
                echo "flat"  # not enough separation
            elif [ "$x" -lt 0 ]; then
                echo "left-up"
            else
                echo "right-up"
            fi
        else
            # Y-dominant: normal (Y neg) or bottom-up (Y pos)
            ratio=$(( abs_y * 10 / (abs_x + 1) ))
            if [ "$ratio" -lt 14 ]; then
                echo "flat"
            elif [ "$y" -lt 0 ]; then
                echo "normal"
            else
                echo "bottom-up"
            fi
        fi
    }

    prev_orientation=""
    disabled_prev=""
    confirm_orientation=""
    confirm_count=0

    log "Polling accelerometer at $ACCEL_BASE (median window=$MEDIAN_WINDOW, confirm=$CONFIRM_COUNT)"

    while true; do
        # ── Toggle check ────────────────────────────────────────────────────
        if [ -f "$FLAG_FILE" ]; then
            if [ "$disabled_prev" != "yes" ]; then
                log "Autorotation DISABLED (flag file present)"
                disabled_prev="yes"
            fi
            sleep "$POLL_INTERVAL"
            continue
        fi
        if [ "$disabled_prev" = "yes" ]; then
            log "Autorotation ENABLED"
            disabled_prev="no"
            prev_orientation=""
            confirm_orientation=""
            confirm_count=0
        fi

        orientation=$(detect_orientation)

        # Skip if flat/ambiguous
        if [ "$orientation" = "flat" ]; then
            confirm_orientation=""
            confirm_count=0
            sleep "$POLL_INTERVAL"
            continue
        fi

        # ── Confirmation gate: require N consecutive identical readings ─────
        if [ "$orientation" = "$confirm_orientation" ]; then
            confirm_count=$(( confirm_count + 1 ))
        else
            confirm_orientation="$orientation"
            confirm_count=1
        fi

        if [ "$confirm_count" -ge "$CONFIRM_COUNT" ] && \
           [ "$orientation" != "$prev_orientation" ]; then
            transform=$(orientation_to_transform "$orientation")
            if [ -n "$transform" ]; then
                log "Orientation: $orientation → transform $transform (confirmed ${confirm_count}x)"
                apply_transform "$transform"
                prev_orientation="$orientation"
            fi
        fi

        sleep "$POLL_INTERVAL"
    done
}

# ── Entry point: prefer monitor-sensor, fall back to sysfs ─────────────────
log "Starting auto-rotation daemon"

if command -v monitor-sensor >/dev/null 2>&1; then
    run_with_monitor_sensor
else
    log "monitor-sensor not found, using sysfs fallback"
    run_sysfs_fallback
fi
